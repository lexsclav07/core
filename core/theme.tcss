/* CORE's look, in Textual CSS (https://textual.textualize.io/guide/CSS/).
 *
 * Black with one light green accent, laid out like Claude Code's terminal UI:
 * no panels or bars, just the conversation, a rounded input box and a quiet
 * line under it. $primary is the accent ([ui] accent in config.toml, CORE's
 * green by default); $success, $warning and $error are libadwaita's. Rice
 * away: restart CORE to see changes, or run `uv run textual run --dev
 * core.app:CoreApp` to see them live.
 */

Screen { background: $background; }
/* Thin, quiet scrollbars everywhere */
* {
    scrollbar-size-vertical: 1; scrollbar-background: $background;
    scrollbar-color: $panel; scrollbar-color-hover: $primary 50%; scrollbar-color-active: $primary;
}

/* Splash */
SplashScreen { align: center middle; }
#logo { width: 100%; content-align: center middle; text-style: bold; color: $primary; }
#splash-status { width: 100%; content-align: center middle; color: $text-muted; margin-top: 1; }

/* The line under everything: hints left, model and context right */
#status { dock: bottom; height: 1; padding: 0 2; background: $background; }
#status-hint { width: 1fr; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
#status-info { width: auto; color: $text-muted; }

/* Views: the tab bar is hidden; /resume, /activity, /settings (F3-F5) switch */
#tabs { height: 1fr; }
#tabs > ContentTabs { display: none; }
TabbedContent, ContentSwitcher, TabPane { background: $background; }
TabPane { padding: 0; }
.view-title { height: 1; margin: 1 2 0 2; }

/* Under the chat: spinner, input box, / menu */
#composer { dock: bottom; height: auto; padding: 0 1; }
#spinner { height: 1; margin: 0 1 1 1; }
#prompt-box {
    height: 3; border: round $foreground 25%; background: $background;
}
#prompt-box:focus-within { border: round $primary 70%; }
#prompt-mark { width: 3; padding-left: 1; color: $text-muted; }
#prompt-box:focus-within #prompt-mark { color: $primary; }
#prompt { border: none; background: transparent; padding: 0 1 0 0; height: 1; }
#prompt:focus { border: none; }
#menu {
    height: auto; max-height: 10; margin: 0 1; padding: 0;
    border: none; background: $background;
}
#menu > .option-list--option-highlighted { background: $panel; color: $primary; }

/* The conversation */
#messages { padding: 0 2; }
.user { height: auto; margin: 1 0 0 0; }
.user .mark { width: 2; color: $text-muted; }
.user .said { width: 1fr; color: $text-muted; }
.reply { height: auto; margin: 1 0 0 0; }
.reply .bullet { width: 2; color: $foreground; }
.assistant { width: 1fr; margin: 0; padding: 0; background: transparent; }
/* Inline `code` in the accent colour, not Textual's warning yellow */
Markdown.assistant MarkdownBlock:dark > .code_inline { background: $primary 10%; color: $primary; }
Markdown.assistant MarkdownBlock:light > .code_inline { background: $primary 10%; color: $primary; }

/* Thinking: a quiet one-liner you can open */
Collapsible { margin: 1 0 0 0; padding: 0; border: none; background: transparent; }
Collapsible CollapsibleTitle { padding: 0; color: $text-muted; text-style: italic; }
Collapsible CollapsibleTitle:hover { background: transparent; color: $primary; }
Collapsible Contents { padding: 0 0 0 2; }
.thinking { color: $text-muted; background: transparent; }

/* Commands, like Claude Code's tool calls: ⏺ Bash(…) then ⎿ output */
.command { height: auto; margin: 1 0 0 0; padding: 0; }
.command-output { padding: 0; }

/* The welcome box at the top of a new chat */
#welcome {
    height: auto; margin: 1 0; padding: 1 2;
    border: round $primary; border-title-color: $primary; border-title-style: bold;
}
#welcome-cols { height: auto; }
#welcome-left { width: 2fr; height: auto; align-horizontal: center; }
#welcome-right {
    width: 3fr; height: auto; padding-left: 2; border-left: solid $primary 40%;
}
#welcome.-narrow #welcome-right {
    width: 1fr; padding: 1 0 0 0; border-left: none; border-top: solid $primary 40%;
}
#welcome.-narrow #welcome-left { width: 1fr; }
.welcome-centre { width: 100%; content-align: center middle; }
#welcome-logo { width: auto; margin: 1 0; color: $primary; text-style: bold; }
#welcome-recent { margin-top: 1; }

/* Gesture mode: a live drawing of your hand on the right */
HandView {
    dock: right; display: none;
    width: 30; height: auto; margin: 1 1 0 0; padding: 0 1;
    border: round $primary; border-title-color: $primary;
}
HandView.-on { display: block; }

/* Questions (approvals, sudo password, yes/no) sit at the bottom like
   Claude Code's permission prompts, over a dimmed screen. */
ApprovalModal, PasswordModal, YesNoModal { align: center bottom; background: $background 50%; }
.ask {
    width: 100%; height: auto; margin: 0 1 2 1; padding: 1 2;
    border: round $primary; background: $background;
    border-title-color: $primary; border-title-style: bold;
}
#approval { border: round $warning; border-title-color: $warning; }
#yes-no { border: round $error; }
.ask-command { margin-bottom: 1; }
.ask-explain { margin-bottom: 1; }
.ask-question { margin-top: 1; text-style: bold; }
.ask-choices { height: auto; }
.ask Input { border: round $foreground 25%; background: $background; }
.ask Input:focus { border: round $primary; }
.facts {
    layout: grid; grid-size: 2; grid-columns: 13 1fr; grid-rows: auto;
    grid-gutter: 0 0; height: auto;
}
.fact-name { color: $text-muted; }
.note { color: $text-muted; }

/* The shortcuts screen (? or F1) */
HelpScreen { align: center middle; background: $background 70%; }
#help {
    width: 90; max-width: 95%; height: auto; max-height: 90%; padding: 1 2;
    border: round $primary; background: $background;
}

/* Resume (History), Activity, Settings */
#history, #activity, #settings { background: $background; }
#history, #activity { padding: 1 2 0 2; }
#history-search, #activity-filter {
    margin-bottom: 1; border: round $foreground 25%; background: $background;
}
#history-search:focus, #activity-filter:focus { border: round $primary; }
DataTable { background: $background; }
DataTable > .datatable--header { background: $background; color: $text-muted; text-style: bold; }
DataTable > .datatable--cursor { background: $panel; color: $primary; text-style: bold; }
DataTable > .datatable--even-row { background: $background; }
DataTable > .datatable--odd-row { background: $background; }
#history-table, #activity-table { height: 1fr; }
#history-note { height: auto; padding: 1 0; }
#activity-detail {
    height: auto; max-height: 9; margin-top: 1; padding: 0 1;
    border-left: thick $primary;
}
#settings { padding: 1 2; }
.settings-heading { text-style: bold; color: $primary; margin-top: 1; }
.setting { height: auto; }
.setting Label { width: 26; padding-top: 1; }
.setting Select { width: 60; }
#settings .note { margin: 0 0 1 26; }
#settings-other { margin-top: 1; }
Select > SelectCurrent { border: round $foreground 25%; background: $background; }
Select:focus > SelectCurrent { border: round $primary; }
Switch { border: round $foreground 25%; background: $background; }
Switch:focus { border: round $primary; }
Switch > .switch--slider { color: $panel; background: $background; }
Switch.-on > .switch--slider { color: $primary; }

/* Toasts */
Toast { background: $panel; border-left: outer $primary; }
Toast.-warning { border-left: outer $warning; }
